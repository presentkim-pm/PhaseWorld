{
  "name": "presentkim/phaseworld",
  "description": "High-performance virtual world instance loader with zero-IO instantiation and memory caching for axolotl-pm/PocketMine-MP",
  "type": "project",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "presentkim/libasynform": "^2.0",
    "sof3/await-generator": "^3.6.1"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0",
    "presentkim/cameraapi": "^2.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/presentkim-pm/CameraAPI"
    }
  ],
  "autoload": {
    "psr-4": {
      "kim\\present\\phaseworld\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\phaseworld\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
